@model LibraryManagementSystem.Models.Fine

@{
    ViewData["Title"] = "Delete Fine";
}

<h1>Delete Fine</h1>

<h3 class="text-danger">
    Are you sure you want to delete this fine?
</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Fine ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Loan ID</dt>
    <dd class="col-sm-9">@Model.LoanId</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

    <dt class="col-sm-3">Payment Status</dt>
    <dd class="col-sm-9">
        @if (Model.IsPaid)
        {
            <span class="badge bg-success">Paid</span>
        }
        else
        {
            <span class="badge bg-danger">Unpaid</span>
        }
    </dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
