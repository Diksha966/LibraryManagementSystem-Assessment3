@model LibraryManagementSystem.Models.ItemTransfer
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = $"Transfer #{Model.Id}";
}

<h1>Transfer #@Model.Id <partial name="_TransferStatusBadge" model="Model.Status" /></h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Item</dt>
            <dd class="col-sm-9">
                <strong>@Model.Item?.Title</strong> (@Model.Item?.LibraryCode)
                @if (Model.Item != null)
                {
                    <partial name="_ItemStatusBadge" model="Model.Item.Status" />
                }
            </dd>

            <dt class="col-sm-3">From</dt>
            <dd class="col-sm-9">@Model.FromBranch?.Name</dd>

            <dt class="col-sm-3">To</dt>
            <dd class="col-sm-9">@Model.ToBranch?.Name</dd>

            <dt class="col-sm-3">Reason</dt>
            <dd class="col-sm-9">@(Model.Reason ?? "–")</dd>
        </dl>
    </div>
</div>

<h2 class="h5 mt-4">History</h2>
<ul class="list-group mb-3" style="max-width: 40rem;">
    <li class="list-group-item">
        <strong>Requested</strong> @Model.RequestedAt.ToString("d MMM yyyy HH:mm") by @Model.RequestedBy
    </li>
    @if (Model.DispatchedAt.HasValue)
    {
        <li class="list-group-item">
            <strong>Dispatched</strong> @Model.DispatchedAt.Value.ToString("d MMM yyyy HH:mm") by @Model.DispatchedBy
        </li>
    }
    @if (Model.ReceivedAt.HasValue)
    {
        <li class="list-group-item list-group-item-success">
            <strong>Received</strong> @Model.ReceivedAt.Value.ToString("d MMM yyyy HH:mm") by @Model.ReceivedBy
        </li>
    }
    @if (Model.CancelledAt.HasValue)
    {
        <li class="list-group-item list-group-item-secondary">
            <strong>Cancelled</strong> @Model.CancelledAt.Value.ToString("d MMM yyyy HH:mm") by @Model.CancelledBy
            @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
            {
                <span>: @Model.CancelReason</span>
            }
        </li>
    }
</ul>

@if (Model.Status == TransferStatus.Requested || Model.Status == TransferStatus.InTransit)
{
    <div class="card" style="max-width: 40rem;">
        <div class="card-body">
            <h2 class="h5">Next step</h2>

            @if (Model.Status == TransferStatus.Requested)
            {
                <p class="mb-2">When the item has been packed and has left <strong>@Model.FromBranch?.Name</strong>, mark it as dispatched. It cannot be borrowed until it is received.</p>
                <form asp-action="Dispatch" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-primary">Mark as Dispatched</button>
                </form>
            }
            else
            {
                <p class="mb-2">When the item arrives at <strong>@Model.ToBranch?.Name</strong>, confirm receipt. The item will move to that branch and become Available.</p>
                <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">Confirm Received</button>
                </form>
            }

            <hr />

            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Cancel transfer #@Model.Id?');">
                <label for="cancelReason" class="form-label">Cancel this transfer</label>
                <div class="input-group">
                    <input type="text" name="cancelReason" id="cancelReason" maxlength="200" class="form-control" placeholder="Reason (optional)" />
                    <button type="submit" class="btn btn-outline-danger">Cancel Transfer</button>
                </div>
                @if (Model.Status == TransferStatus.InTransit)
                {
                    <div class="form-text">The item will return to @Model.FromBranch?.Name and become Available again.</div>
                }
            </form>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to Transfers</a>
</div>
