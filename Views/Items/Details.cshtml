@model LibraryManagementSystem.Models.Item

@{
    ViewData["Title"] = "Item Details";
}

<h1>Item Details</h1>

<div class="card mt-3">
    <div class="card-body">

        <h2 class="card-title">@Model.Title</h2>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">
                Library Code
            </dt>
            <dd class="col-sm-9">
                <strong>@Model.LibraryCode</strong>
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>
            <dd class="col-sm-9">
                @Model.Description
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                <partial name="_ItemStatusBadge" model="Model.Status" />
            </dd>

            <dt class="col-sm-3">
                Branch
            </dt>
            <dd class="col-sm-9">
                @(Model.Branch?.Name ?? "–")
            </dd>

        </dl>

        @if (Model is LibraryManagementSystem.Models.Book book)
        {
            <hr />

            <h3>Book Information</h3>

            <dl class="row">
                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9">@book.Author</dd>

                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@book.Genre</dd>

                <dt class="col-sm-3">ISBN</dt>
                <dd class="col-sm-9">@book.ISBN</dd>
            </dl>
        }

        @if (Model is LibraryManagementSystem.Models.Toy toy)
        {
            <hr />

            <h3>Toy Information</h3>

            <dl class="row">
                <dt class="col-sm-3">Toy Type</dt>
                <dd class="col-sm-9">@toy.ToyType</dd>

                <dt class="col-sm-3">Recommended Age</dt>
                <dd class="col-sm-9">@toy.RecommendedAge+</dd>
            </dl>
        }

        @if (Model is LibraryManagementSystem.Models.Music music)
        {
            <hr />

            <h3>Music Information</h3>

            <dl class="row">
                <dt class="col-sm-3">Artist</dt>
                <dd class="col-sm-9">@music.Artist</dd>

                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@music.Year</dd>

                <dt class="col-sm-3">Format</dt>
                <dd class="col-sm-9">@music.Format</dd>
            </dl>
        }

    </div>
</div>

@{
    var transfers = ViewBag.Transfers as List<LibraryManagementSystem.Models.ItemTransfer>
                    ?? new List<LibraryManagementSystem.Models.ItemTransfer>();
}

<!-- Person 1: where this item has been moved -->
<h2 class="h4 mt-4">Transfer history</h2>

@if (!transfers.Any())
{
    <p class="text-muted">This item has not been transferred between branches.</p>
}
else
{
    <partial name="~/Views/Transfers/_TransferTable.cshtml" model="transfers" />
}

<div class="mt-3">
    @if (Model.Status == LibraryManagementSystem.Models.ItemStatus.Available &&
         !transfers.Any(t => t.IsOpen))
    {
        <a asp-controller="Transfers"
           asp-action="Create"
           asp-route-itemId="@Model.Id"
           class="btn btn-outline-primary">
            Transfer to another branch
        </a>
    }

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>
</div>