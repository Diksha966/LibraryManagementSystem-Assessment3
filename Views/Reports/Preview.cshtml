@using LibraryManagementSystem.Services
@model ReportTable
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h1 class="display-6 fw-bold mb-0">@Model.Title</h1>
            <p class="text-muted mb-0">Generated @Model.GeneratedAt.ToString("d MMM yyyy HH:mm")</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Download" asp-route-type="@Model.Key" asp-route-format="csv" class="btn btn-primary">Download CSV</a>
            <a asp-action="Download" asp-route-type="@Model.Key" asp-route-format="pdf" class="btn btn-danger">Download PDF</a>
            <a asp-action="Index" class="btn btn-outline-secondary">All reports</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var (label, value) in Model.Summary)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 bg-light">
                    <div class="card-body">
                        <h6 class="text-muted">@label</h6>
                        <h3>@value</h3>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Rows.Any())
    {
        <div class="alert alert-info">There are no records for this report yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                    <tr>
                        @foreach (var column in Model.Columns)
                        {
                            <th>@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
