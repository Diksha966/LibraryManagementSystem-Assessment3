@model LibraryManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Delete Loan";
}

<h1>Delete Loan</h1>

<h3>Are you sure you want to delete this loan?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-3">Item</dt>
        <dd class="col-sm-9">@Model.Item?.Title</dd>

        <dt class="col-sm-3">Borrower</dt>
        <dd class="col-sm-9">@Model.Borrower?.Name</dd>

        <dt class="col-sm-3">Borrowed Date</dt>
        <dd class="col-sm-9">@Model.BorrowedDate.ToShortDateString()</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
