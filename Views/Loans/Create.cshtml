@model LibraryManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Create Loan";
}

<h1>Create Loan</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="LibraryCode" class="form-label">
                    Library Code
                </label>

                <input type="text"
                       id="LibraryCode"
                       name="LibraryCode"
                       class="form-control"
                       placeholder="e.g. BK002"
                       autocomplete="off"
                       required />

                <div class="form-text">
                    Enter the library code printed on the item.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="BorrowerId" class="form-label">
                    Borrower
                </label>

                <select asp-for="BorrowerId"
                        class="form-select"
                        asp-items="ViewBag.BorrowerId">
                    <option value="">-- Select a borrower --</option>
                </select>

                <span asp-validation-for="BorrowerId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Create Loan
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}