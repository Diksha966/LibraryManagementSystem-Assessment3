@model IEnumerable<LibraryManagementSystem.Models.Loan>

@{
    ViewData["Title"] = "Loans";
}

<h1>Loans</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Loan</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Borrower</th>
            <th>Borrowed Date</th>
            <th>Due Date</th>
            <th>Returned Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var loan in Model)
        {
            <tr>
                <td>@loan.Item?.Title</td>

                <td>@loan.Borrower?.Name</td>

                <td>@loan.BorrowedDate.ToShortDateString()</td>

                <td>@loan.DueDate.ToShortDateString()</td>

                <td>
                    @(loan.ReturnedDate.HasValue
                        ? loan.ReturnedDate.Value.ToShortDateString()
                        : "Not returned")
                </td>

                <td>
                    @loan.Status
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@loan.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@loan.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@loan.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                    @if (loan.Status == LoanStatus.Active)
                    {
                        <form asp-action="Return"
                              asp-route-id="@loan.Id"
                              method="post"
                              style="display:inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-success btn-sm"
                                    onclick="return confirm('Mark this loan as returned?');">
                                Return
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>