@model LibraryManagementSystem.Models.Loan

@{
    ViewData["Title"] = "Edit Loan";
}

<h1>Edit Loan</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BorrowedDate" />
    <input type="hidden" asp-for="ReturnedDate" />
    <input type="hidden" asp-for="Status" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ItemId" class="form-label">Item</label>
        <select asp-for="ItemId" class="form-control" asp-items="ViewBag.ItemId"></select>
        <span asp-validation-for="ItemId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BorrowerId" class="form-label">Borrower</label>
        <select asp-for="BorrowerId" class="form-control" asp-items="ViewBag.BorrowerId"></select>
        <span asp-validation-for="BorrowerId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
