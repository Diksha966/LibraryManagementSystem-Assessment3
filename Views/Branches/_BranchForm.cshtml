@model LibraryManagementSystem.Models.Branch

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Code" class="form-label"></label>
    <input asp-for="Code" class="form-control" placeholder="e.g. PAL" style="max-width: 12rem; text-transform: uppercase;" />
    <div class="form-text">Short unique code, letters and numbers only.</div>
    <span asp-validation-for="Code" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" placeholder="e.g. Palmerston Branch" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label"></label>
    <div class="form-text">Inactive branches cannot receive transfers or new items.</div>
    <span asp-validation-for="IsActive" class="text-danger d-block"></span>
</div>
