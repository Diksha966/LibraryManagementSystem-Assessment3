@{
    ViewData["Title"] = "Manager Dashboard";
    var recentNotifications = ViewBag.RecentNotifications as List<LibraryManagementSystem.Models.NotificationLog>
        ?? new List<LibraryManagementSystem.Models.NotificationLog>();
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">Manager Dashboard</h1>
        <p class="text-muted">
            Overview of borrowing activity, item status and fines.
        </p>
          <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary"
                    href="/api/exports/loans.csv">Export Loans CSV</a>
                <a class="btn btn-outline-primary"
                    href="/api/exports/notifications.csv">Export Notifications CSV</a>
                <a class="btn btn-outline-secondary"
                    href="/api/exports/dashboard.pdf">Export Dashboard PDF</a>
          </div>
    </div>

    <!-- Borrowing Statistics -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h4 mb-3">Borrowing Statistics</h2>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Total Loans</h6>
                            <h2>@ViewBag.TotalLoans</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Active Loans</h6>
                            <h2>@ViewBag.ActiveLoans</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Returned Loans</h6>
                            <h2>@ViewBag.ReturnedLoans</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Overdue Loans</h6>
                            <h2>@ViewBag.OverdueLoans</h2>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Item Statistics -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h4 mb-3">Item Status Statistics</h2>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Total Items</h6>
                            <h2>@ViewBag.TotalItems</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Available</h6>
                            <h2>@ViewBag.AvailableItems</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Borrowed</h6>
                            <h2>@ViewBag.BorrowedItems</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Damaged</h6>
                            <h2>@ViewBag.DamagedItems</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Destroyed</h6>
                            <h2>@ViewBag.DestroyedItems</h2>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Fine Statistics -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h4 mb-3">Fine Statistics</h2>

            <div class="row g-3">

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Total Fines</h6>
                            <h2>@ViewBag.TotalFines</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Paid Fines</h6>
                            <h2>@ViewBag.PaidFines</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Unpaid Fines</h6>
                            <h2>@ViewBag.UnpaidFines</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Total Fine Amount</h6>
                            <h2>$@ViewBag.TotalFineAmount.ToString("0.00")</h2>
                        </div>
                    </div>
                </div>

            </div>

            <div class="mt-3">
                <strong>Unpaid Fine Amount:</strong>
                $@ViewBag.UnpaidFineAmount.ToString("0.00")
            </div>

        </div>
    </div>

    <!-- Notification Statistics -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h4 mb-3">Notification Activity</h2>

            <div class="row g-3 mb-4">

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Total Notifications</h6>
                            <h2>@ViewBag.TotalNotifications</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Warning Notifications</h6>
                            <h2>@ViewBag.WarningNotifications</h2>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 bg-light">
                        <div class="card-body">
                            <h6 class="text-muted">Error Notifications</h6>
                            <h2>@ViewBag.ErrorNotifications</h2>
                        </div>
                    </div>
                </div>
            </div>

            <h3 class="h5">Recent Notifications</h3>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Time (UTC)</th>
                            <th>Category</th>
                            <th>Severity</th>
                            <th>Title</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentNotifications.Any())
                        {
                            @foreach (var notification in recentNotifications)
                            {
                                <tr>
                                    <td>@notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@notification.Category</td>
                                    <td>@notification.Severity</td>
                                    <td>@notification.Title</td>
                                    <td>@notification.Message</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-muted">No notifications logged yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>