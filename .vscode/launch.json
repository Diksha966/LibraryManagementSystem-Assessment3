{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LibraryManagementSystem (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare-run",
      "program": "dotnet",
      "args": [
        "run",
        "--launch-profile",
        "https"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
